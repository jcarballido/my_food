# Server package environment variables (server-side only)
# Copy to packages/server/.env for local development.

# HTTP server
PORT=3001
HOST=0.0.0.0

# PostgreSQL connection string (shared with @my_food/database)
DATABASE_URL=postgresql://user:password@host:5432/database

# Supabase project
SUPABASE_URL=https://your-project.supabase.co
# Legacy HS256 signing secret. Optional: when omitted, the project's published
# asymmetric keys (JWKS) are used to verify access tokens instead.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Key used for provider API calls (magic-link initiation). The anon key is
# sufficient; a service role key may be used instead. The anon key is
# client-safe; a service role key must never be exposed to the browser.
SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Comma-separated allowlist of emails permitted to start a sign-in.
# Only the server may read this. Values are trimmed and compared case-insensitively.
ALLOWED_EMAILS=user1@example.com,user2@example.com

# Frontend URL the provider redirects to after a magic link is followed.
AUTH_CALLBACK_URL=http://localhost:5173/auth/callback

# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGIN=http://localhost:5173

# IANA timezone used to resolve the current calendar month.
APP_TIMEZONE=UTC

# Pino log level: fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info

# NODE_ENV=development
