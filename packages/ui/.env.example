# UI package environment variables (VITE_ prefixed, client-safe only)
# Copy to packages/ui/.env for local development.

# Base URL of the API server
VITE_API_BASE_URL=http://localhost:3001

# Supabase project (client-safe values only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Route the provider redirects to after a magic link is followed.
# Must match the server's AUTH_CALLBACK_URL.
VITE_AUTH_CALLBACK_URL=http://localhost:5173/auth/callback
